{
  "expo": {
    "name": "Air OXLY",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "airoxly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.oxlycrm.taw2qk",
      "infoPlist": {
        "NSCameraUsageDescription": "Foto barcode pelanggan & foto nota pengeluaran real-time",
        "NSLocationWhenInUseUsageDescription": "Melacak lokasi sales di lapangan",
        "NSPhotoLibraryUsageDescription": "Simpan screenshot laporan ke galeri",
        "NSPhotoLibraryAddUsageDescription": "Simpan screenshot laporan ke galeri"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.oxlycrm.taw2qk",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "READ_MEDIA_IMAGES", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Air OXLY",
      "shortName": "Air OXLY",
      "themeColor": "#0F172A",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "lang": "id"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Izinkan aplikasi mengakses kamera untuk scan barcode pelanggan & foto nota pengeluaran" }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Foto nota pengeluaran langsung dari kamera (real-time, bukan dari galeri)"
        }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Izinkan aplikasi mengakses lokasi untuk melacak sales di lapangan" }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Simpan screenshot laporan bulanan ke galeri HP",
          "savePhotosPermission": "Simpan screenshot laporan bulanan ke galeri HP",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}